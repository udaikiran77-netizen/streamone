<?xml version="1.0" encoding="utf-8"?>
<!--
  StreamOne launcher foreground: a bold tomato (#FF6347) play triangle on a
  108x108 canvas, with an "S" curve cut through it (stroked in the launcher
  background colour, #000000, so it reads as negative space over the black
  adaptive-icon background). Artwork stays inside the adaptive-icon safe
  zone (centre 66dp circle).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Play triangle with rounded corners -->
    <path
        android:fillColor="#FF6347"
        android:pathData="M38,40 A6,6 0 0 1 44.3,36.1 L71.9,50 A7,7 0 0 1 71.9,58 L44.3,71.9 A6,6 0 0 1 38,68 Z" />

    <!-- S cut: thick background-coloured stroke over the triangle -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M57,45 C57,39.5 43,40.5 43,47.5 C43,53.5 57,54.5 57,61 C57,67.5 43.5,68 43,62" />
</vector>
